{
  "name": "keil-vscode-assistant",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "2.0.0",
  "publisher": "Dastan",
  "icon": "res/icons/icon.png",
  "author": "Dastan <dastan@139.com>",
  "readme": "README.md",
  "license": "SEE LICENSE IN LICENSE",
  "l10n": "./l10n",
  "keywords": [
    "keil",
    "embedded",
    "uVision",
    "microcontroller",
    "CMSIS",
    "mdk",
    "c51",
    "c251",
    "8051",
    "stm32",
    "ARM7",
    "ARM9"
  ],
  "homepage": "https://github.com/Dastan-Prince/keil-assistant",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other",
    "Extension Packs"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dastan-Prince/keil-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/Dastan-Prince/keil-assistant/issues",
    "email": "dastan@139.com"
  },
  "extensionPack": [],
  "extensionDependencies": [],
  "extensionKind": [
    "workspace"
  ],
  "scripts": {
    "setup": "npm install",
    "compile": "npm run check-types && ts-node esbuild.ts",
    "check-types": "tsc --noEmit",
    "compile-unit-test": "tsc --build test.tsconfig.json",
    "compile-watch-unit-test": "tsc --build test.tsconfig.json --watch",
    "watch": "npm run compile && npm run watch:tsc",
    "watch:esbuild": "ts-node esbuild.ts --watch",
    "watch-tsc": "tsc --build tsconfig.json --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "compile-tests": "tsc -p test.tsconfig.json --outDir out",
    "watch-tests": "tsc -p test.tsconfig.json --watch --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "lint": "oxlint .",
    "test": "ts-node ./out/test/runTest.js",
    "package": "npm run check-types && ts-node esbuild.ts --production",
    "vscode:prepublish": "npm run package",
    "vsce-package": "vsce package",
    "vsce-package-pre": "vsce package --pre-release",
    "vsce-publish": "vsce publish",
    "deploy": "vsce publish"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "ini": "^7.0.0"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.x",
    "@types/vscode": "^1.73.0",
    "@vscode/dts": "^0.4.1",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "chokidar": "^5.0.0",
    "esbuild": "^0.27.2",
    "fast-xml-parser": "^5.3.3",
    "iconv-lite": "^0.7.1",
    "mocha": "^11.7.5",
    "oxlint": "^1.34.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "viewsWelcome": [
      {
        "view": "project",
        "contents": "%keil-assistant.contributes.viewsWelcome.project.content%"
      }
    ],
    "configuration": [
      {
        "title": "%keil-assistant.contributes.conf.title%",
        "properties": {
          "KeilAssistant.Keil.HOME": {
            "type": "object",
            "markdownDescription": "%keil-assistant.contributes.conf.props.keil.home.markdownDescription%",
            "additionalProperties": {
              "type": "string"
            },
            "default": {
              "MDK": "C:\\Keil_v5"
            }
          },
          "KeilAssistant.Keil.JCRE": {
            "type": "string",
            "markdownDescription": "**Java Card 运行时环境（JCRE）源码根目录**。\n\n插件会扫描工程中所有 `mask.c`，识别形如 `/* class@... interface javacard/security/SecretKey */` 的注释，然后在这个路径下查找对应的 `.java` 文件（例如 `javacard/security/SecretKey.java`），并以树形 symlink 放入统一虚拟根的 `JCRE/` 子目录中，让 `Ctrl+Shift+F` 能搜到这些标准 API 源码。\n\n示例：`C:\\PersonalData\\gitRepos\\javacard-api\\src`\n\n留空则不扫描 JCRE。",
            "default": ""
          },
          "KeilAssistant.Project.ExcludeList": {
            "type": "array",
            "scope": "resource",
            "markdownDescription": "%keil-assistant.contributes.conf.props.project.excludeList.description%",
            "default": [
              "template.uvproj",
              "template.uvprojx",
              "template.uvmpw"
            ]
          },
          "KeilAssistant.Project.FileLocationList": {
            "type": "array",
            "scope": "resource",
            "markdownDescription": "%keil-assistant.contributes.conf.props.project.fileLocationList.description%",
            "default": []
          },
          "KeilAssistant.Project.CustomIncludePaths": {
            "type": "array",
            "scope": "resource",
            "markdownDescription": "%keil-assistant.contributes.conf.props.project.customIncludePaths.description%",
            "default": []
          },
          "KeilAssistant.Project.FindMaxDepth": {
            "type": "number",
            "scope": "resource",
            "markdownDescription": "%keil-assistant.contributes.conf.props.project.FindMaxDepth.description%",
            "default": 1
          },
          "KeilAssistant.Workspace.AutoAddExternalSources": {
            "type": "boolean",
            "scope": "window",
            "markdownDescription": "%keil-assistant.contributes.conf.props.workspace.autoAddExternalSources.description%",
            "default": true
          },
          "KeilAssistant.Workspace.ProcessMode": {
            "type": "string",
            "enum": ["activeTarget", "allTargets"],
            "enumDescriptions": [
              "仅处理当前活动 Target 的源码文件",
              "处理所有 Target 的源码文件（去重合并）"
            ],
            "scope": "window",
            "markdownDescription": "%keil-assistant.contributes.conf.props.workspace.processMode.description%",
            "default": "activeTarget"
          },
          "KeilAssistant.Workspace.AddStrategy": {
            "type": "string",
            "enum": ["virtualSymlink", "minimalCommonRoot"],
            "enumDescriptions": [
              "创建虚拟目录树 + 符号链接，按 JCVM/{TargetName}/{GroupName}/FileName 层级展示，Explorer 可见且 Ctrl+Shift+F 可全局搜索。需要 Windows 开发者模式或管理员权限（默认）",
              "直接将外部源码的最小公共根目录加入工作区：不依赖额外权限，Ctrl+Shift+F 一定能搜索到，但 Explorer 里显示的是物理目录名（扁平，不按 GroupName 分组）"
            ],
            "scope": "window",
            "markdownDescription": "%keil-assistant.contributes.conf.props.workspace.addStrategy.description%",
            "default": "virtualSymlink"
          },
          "KeilAssistant.Workspace.ConfirmBeforeAdd": {
            "type": "boolean",
            "scope": "window",
            "markdownDescription": "%keil-assistant.contributes.conf.props.workspace.confirmBeforeAdd.description%",
            "default": false
          }
        }
      }
    ],
    "commands": [
      {
        "command": "explorer.open",
        "title": "%keil-assistant.contributes.commands.project-open.title%",
        "icon": {
          "light": "./res/icons/ClassAdded_16x_light.svg",
          "dark": "./res/icons/ClassAdded_16x_dark.svg"
        }
      },
      {
        "command": "project.switch",
        "title": "%keil-assistant.contributes.commands.project-open.title%",
        "icon": {
          "light": "./res/icons/SwitchSourceOrTarget_16x_light.svg",
          "dark": "./res/icons/SwitchSourceOrTarget_16x_dark.svg"
        }
      },
      {
        "command": "project.active",
        "title": "%keil-assistant.contributes.commands.project-active.title%"
      },
      {
        "command": "project.close",
        "title": "%keil-assistant.contributes.commands.project-close.title%",
        "icon": {
          "light": "./res/icons/StatusOffline_16x_light.svg",
          "dark": "./res/icons/StatusOffline_16x_dark.svg"
        }
      },
      {
        "command": "project.build",
        "title": "%keil-assistant.contributes.commands.project-build.title%",
        "icon": {
          "light": "./res/icons/BuildSelection_16x_light.svg",
          "dark": "./res/icons/BuildSelection_16x_dark.svg"
        }
      },
      {
        "command": "project.rebuild",
        "title": "%keil-assistant.contributes.commands.project-rebuild.title%",
        "icon": {
          "light": "./res/icons/BuildSolution_16x_light.svg",
          "dark": "./res/icons/BuildSolution_16x_dark.svg"
        }
      },
      {
        "command": "project.download",
        "title": "%keil-assistant.contributes.commands.project-download.title%",
        "icon": {
          "light": "./res/icons/TransferDownload_16x_light.svg",
          "dark": "./res/icons/TransferDownload_16x_dark.svg"
        }
      },
      {
        "command": "item.copyValue",
        "title": "%keil-assistant.contributes.commands.project-copy.title%",
        "icon": {
          "light": "./res/icons/CopyToClipboard_16x_light.svg",
          "dark": "./res/icons/CopyToClipboard_16x_dark.svg"
        }
      },
      {
        "command": "project.generateCompileCommandsJson",
        "title": "%keil-assistant.contributes.commands.project-generateCompileCommandsJson%"
      },
      {
        "command": "workspace.sync",
        "title": "Keil: Sync Workspace Folders"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "explorer.open",
          "group": "navigation",
          "when": "view == project"
        }
      ],
      "view/item/context": [
        {
          "command": "project.close",
          "when": "viewItem == Project"
        },
        {
          "command": "project.active",
          "when": "viewItem == Project"
        },
        {
          "command": "project.switch",
          "group": "inline",
          "when": "viewItem == Project"
        },
        {
          "command": "project.build",
          "group": "inline",
          "when": "viewItem == Target"
        },
        {
          "command": "project.rebuild",
          "group": "inline",
          "when": "viewItem == Target"
        },
        {
          "command": "project.download",
          "group": "inline",
          "when": "viewItem == Target"
        },
        {
          "command": "item.copyValue",
          "group": "inline",
          "when": "viewItem == Source"
        }
      ]
    },
    "keybindings": [
      {
        "command": "project.build",
        "key": "F7"
      },
      {
        "command": "project.rebuild",
        "key": "ALT+F7"
      },
      {
        "command": "project.download",
        "key": "F8"
      },
      {
        "command": "project.switch",
        "key": "CTRL+T"
      }
    ],
    "snippets": [
      {
        "language": "a51",
        "path": "./syntaxes/a51.snippets.json"
      },
      {
        "language": "a251",
        "path": "./syntaxes/a251.snippets.json"
      }
    ],
    "languages": [
      {
        "id": "a51",
        "aliases": [
          "A51",
          "8051 Assembly"
        ],
        "extensions": [
          ".a51",
          ".A51"
        ],
        "filenamePatterns": [
          "**/*.a51",
          "**/*.A51"
        ],
        "configuration": "./syntaxes/a51.language-configuration.json"
      },
      {
        "id": "a251",
        "aliases": [
          "A251",
          "80251 Assembly"
        ],
        "extensions": [
          ".a251",
          ".A251"
        ],
        "filenamePatterns": [
          "**/*.a251",
          "**/*.A251"
        ],
        "configuration": "./syntaxes/a251.language-configuration.json"
      },
      {
        "id": "Log",
        "mimetypes": [
          "text/x-code-output"
        ]
      }
    ],
    "grammars": [
      {
        "language": "a51",
        "scopeName": "source.asm.a51",
        "path": "./syntaxes/a51.tmLanguage.json"
      },
      {
        "language": "a251",
        "scopeName": "source.asm.a251",
        "path": "./syntaxes/a251.tmLanguage.json"
      },
      {
        "language": "Log",
        "scopeName": "build-log",
        "path": "./syntaxes/build-log.tmLanguage"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "project",
          "title": "%keil-assistant.contributes.views.explorer.name%",
          "icon": "res/icons/icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "icon": "res/icons/icon.svg",
          "id": "project",
          "name": "%keil-assistant.contributes.views.explorer.name%"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "keil-task"
      }
    ],
    "problemMatchers": [
      {
        "name": "c51",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning)\\s+([A-Z0-9]+):\\s+(.+)$",
            "file": 1,
            "location": 2,
            "severity": 3,
            "code": 4,
            "message": 5
          }
        ]
      },
      {
        "name": "c251",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning)\\s+([A-Z0-9]+):\\s+(.+)$",
            "file": 1,
            "location": 2,
            "severity": 3,
            "code": 4,
            "message": 5
          }
        ]
      },
      {
        "name": "armcc",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning):\\s+#([\\d\\w-]+):\\s+(.+)$",
            "file": 1,
            "location": 2,
            "severity": 3,
            "code": 4,
            "message": 5
          }
        ]
      },
      {
        "name": "gcc",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ]
      }
    ]
  }
}
